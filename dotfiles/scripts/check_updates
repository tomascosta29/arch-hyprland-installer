#!/usr/bin/env bash
# ==============================================================================
# Arch Linux Pacman Update Checker for Waybar
# ==============================================================================

set -euo pipefail

if command -v checkupdates &>/dev/null; then
    UPDATES=$(checkupdates 2>/dev/null | wc -l || echo 0)
else
    UPDATES=0
fi

if [[ "${UPDATES}" -gt 0 ]]; then
    echo "{\"text\":\"󰏔 ${UPDATES}\",\"tooltip\":\"${UPDATES} updates available\",\"class\":\"pending\"}"
else
    echo "{\"text\":\"󰏔 0\",\"tooltip\":\"System up to date\",\"class\":\"updated\"}"
fi
