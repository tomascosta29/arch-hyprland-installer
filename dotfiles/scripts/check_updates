#!/usr/bin/env bash
# Return a Waybar JSON payload for pending Arch package updates.

set -Eeuo pipefail

updates=()
if command -v checkupdates >/dev/null 2>&1; then
    mapfile -t updates < <(checkupdates 2>/dev/null || true)
fi

count=${#updates[@]}
if ((count > 0)); then
    printf '{"text":"󰏔 %d","tooltip":"%d update%s available","class":"pending"}\n' \
        "${count}" "${count}" "$([[ ${count} -eq 1 ]] || printf s)"
else
    printf '{"text":"󰏔 0","tooltip":"System up to date","class":"updated"}\n'
fi
