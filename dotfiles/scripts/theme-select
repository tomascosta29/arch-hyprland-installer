#!/usr/bin/env bash
# Apply one complete desktop theme to every supported component.

set -Eeuo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly THEMES_DIR="${CONFIG_DIR}/themes"
readonly THEME_STATE_DIR="${CONFIG_DIR}/costa"
readonly RELOAD_DESKTOP="${COSTA_THEME_RELOAD:-1}"
readonly REQUIRED_FILES=(
    colors.css
    colors.lua
    dunstrc
    gtk-4.0/gtk.css
    kitty-theme.conf
    lock.conf
    rofi-theme.rasi
    wallpaper.png
)

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

choose_theme() {
    local selection

    [[ -d "${THEMES_DIR}" ]] ||
        die "Themes directory '${THEMES_DIR}' does not exist."
    command -v rofi >/dev/null 2>&1 ||
        die "Rofi is required for interactive theme selection."

    selection="$(
        find "${THEMES_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
            LC_ALL=C sort |
            rofi -dmenu -i -p "󰔎 Select Theme"
    )"
    [[ -n "${selection}" ]] || exit 0
    printf '%s\n' "${selection}"
}

atomic_symlink() {
    local target=$1 destination=$2 destination_dir temp_link

    destination_dir="$(dirname "${destination}")"
    mkdir -p "${destination_dir}"
    temp_link="${destination_dir}/.$(basename "${destination}").theme.$$"
    rm -f "${temp_link}"
    ln -s "${target}" "${temp_link}"
    mv -Tf "${temp_link}" "${destination}"
}

validate_theme() {
    local required_variable
    local gtk_css="${TARGET_THEME}/gtk-4.0/gtk.css"

    for required_variable in \
        background background-alt1 background-alt2 background-alt3 background-alt4 \
        foreground foreground-dim \
        soft-blue soft-cyan soft-green soft-yellow soft-peach soft-lavender \
        soft-red soft-grey; do
        grep -Eq "^@define-color ${required_variable} #[A-Fa-f0-9]{6};" \
            "${TARGET_THEME}/colors.css" ||
            die "Theme '${THEME}' has an invalid or missing '${required_variable}' color."
    done
    for required_variable in \
        --window-bg-color --window-fg-color \
        --sidebar-bg-color --sidebar-fg-color \
        --popover-bg-color --popover-fg-color \
        --headerbar-bg-color --headerbar-fg-color \
        --view-bg-color --view-fg-color \
        --accent-bg-color --accent-fg-color; do
        grep -Fq -- "${required_variable}:" "${gtk_css}" ||
            die "Theme '${THEME}' GTK CSS is missing '${required_variable}'."
    done
    grep -Eq -- '^hl\.config\(\{' "${TARGET_THEME}/colors.lua" ||
        die "Theme '${THEME}' does not contain a Hyprland Lua configuration."
    if command -v luac >/dev/null 2>&1; then
        luac -p "${TARGET_THEME}/colors.lua" ||
            die "Theme '${THEME}' has invalid Lua syntax."
    fi
}

write_gtk_settings() {
    local settings_dir settings_file settings_temp

    for settings_dir in "${CONFIG_DIR}/gtk-3.0" "${CONFIG_DIR}/gtk-4.0"; do
        mkdir -p "${settings_dir}"
        settings_file="${settings_dir}/settings.ini"
        settings_temp="${settings_dir}/.settings.ini.theme.$$"
        cat > "${settings_temp}" <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=1
EOF
        chmod 0644 "${settings_temp}"
        mv -f "${settings_temp}" "${settings_file}"
    done
}

apply_gtk_color_scheme() {
    write_gtk_settings
    if command -v gsettings >/dev/null 2>&1 &&
        [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark \
            >/dev/null 2>&1 || true
    fi
}

if (($# > 1)); then
    die "Usage: theme-select [theme-name]"
fi
[[ "${RELOAD_DESKTOP}" == 0 || "${RELOAD_DESKTOP}" == 1 ]] ||
    die "COSTA_THEME_RELOAD must be 0 or 1."

THEME="${1:-}"
[[ -n "${THEME}" ]] || THEME="$(choose_theme)"
[[ "${THEME}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "Theme name contains unsupported characters."

readonly THEME
readonly TARGET_THEME="${THEMES_DIR}/${THEME}"
[[ -d "${TARGET_THEME}" ]] || die "Theme '${THEME}' does not exist."

for required_file in "${REQUIRED_FILES[@]}"; do
    [[ -f "${TARGET_THEME}/${required_file}" ]] ||
        die "Theme '${THEME}' is incomplete: missing '${required_file}'."
done
validate_theme

printf 'Applying theme: %s\n' "${THEME}"

mkdir -p "${THEME_STATE_DIR}"

# Each consumer follows this stable path. Once these links exist, changing all
# theme components is a single atomic symlink rename below.
atomic_symlink "${THEME_STATE_DIR}/current-theme/colors.lua" \
    "${CONFIG_DIR}/hypr/current_colors.lua"
atomic_symlink "${THEME_STATE_DIR}/current-theme/lock.conf" \
    "${CONFIG_DIR}/hypr/current_lock.conf"
atomic_symlink "${THEME_STATE_DIR}/current-theme/colors.css" \
    "${CONFIG_DIR}/quickshell/costa/colors.css"
atomic_symlink "${THEME_STATE_DIR}/current-theme/kitty-theme.conf" \
    "${CONFIG_DIR}/kitty/kitty-theme.conf"
atomic_symlink "${THEME_STATE_DIR}/current-theme/rofi-theme.rasi" \
    "${CONFIG_DIR}/rofi/rofi-theme.rasi"
atomic_symlink "${THEME_STATE_DIR}/current-theme/dunstrc" \
    "${CONFIG_DIR}/dunst/dunstrc"
atomic_symlink "${THEME_STATE_DIR}/current-theme/gtk-4.0/gtk.css" \
    "${CONFIG_DIR}/gtk-4.0/gtk.css"
atomic_symlink "${THEME_STATE_DIR}/current-theme/wallpaper.png" \
    "${CONFIG_DIR}/hypr/current_wallpaper.png"

atomic_symlink "${TARGET_THEME}" "${THEME_STATE_DIR}/current-theme"
apply_gtk_color_scheme

hyprpaper_temp="$(mktemp "${CONFIG_DIR}/hypr/.hyprpaper.conf.XXXXXX")"
cat > "${hyprpaper_temp}" <<HYPRPAPER
wallpaper {
    monitor =
    path = ${CONFIG_DIR}/hypr/current_wallpaper.png
    fit_mode = cover
}
splash = false
HYPRPAPER
chmod 0644 "${hyprpaper_temp}"
mv -f "${hyprpaper_temp}" "${CONFIG_DIR}/hypr/hyprpaper.conf"

# SDDM is intentionally an installation-time theme. A desktop user cannot
# safely mutate /usr/share, and silently skipping that update was misleading.

if [[ "${RELOAD_DESKTOP}" == 1 ]] &&
    command -v hyprctl >/dev/null 2>&1 &&
    pgrep -x Hyprland >/dev/null; then
    hyprctl reload >/dev/null 2>&1 || true
fi
if [[ "${RELOAD_DESKTOP}" == 1 ]] &&
    command -v systemctl >/dev/null 2>&1 &&
    systemctl --user is-active --quiet hyprland-session.target; then
    systemctl --user try-restart hyprpaper.service >/dev/null 2>&1 || true
    systemctl --user try-reload-or-restart quickshell.service >/dev/null 2>&1 || true
    systemctl --user try-reload-or-restart dunst.service >/dev/null 2>&1 || true
fi
if [[ "${RELOAD_DESKTOP}" == 1 ]] && pgrep -x kitty >/dev/null 2>&1; then
    pkill -USR1 -x kitty >/dev/null 2>&1 || true
fi

# GTK providers are process-local. Ask the singleton to exit cleanly so its
# next invocation reads the newly selected GTK theme.
if [[ "${RELOAD_DESKTOP}" == 1 && -x "${HOME}/.local/bin/costa-utils" ]]; then
    "${HOME}/.local/bin/costa-utils" --shutdown >/dev/null 2>&1 || true
fi

if [[ "${RELOAD_DESKTOP}" == 1 ]] &&
    command -v notify-send >/dev/null 2>&1 &&
    [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    notify-send -i preferences-desktop-theme \
        "Theme Engine" "Applied '${THEME}' to the desktop." || true
fi

printf "Theme '%s' applied successfully.\n" "${THEME}"
