#!/usr/bin/env bash
# Apply one complete desktop theme to every supported component.

set -Eeuo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly THEMES_DIR="${CONFIG_DIR}/themes"
readonly REQUIRED_FILES=(
    colors.conf
    colors.css
    colors.lua
    dunstrc
    gtk-4.0/gtk.css
    kitty-theme.conf
    rofi-theme.rasi
    wallpaper.png
)

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

choose_theme() {
    local selection

    [[ -d "${THEMES_DIR}" ]] ||
        die "Themes directory '${THEMES_DIR}' does not exist."
    command -v rofi >/dev/null 2>&1 ||
        die "Rofi is required for interactive theme selection."

    selection="$(
        find "${THEMES_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
            LC_ALL=C sort |
            rofi -dmenu -i -p "󰔎 Select Theme"
    )"
    [[ -n "${selection}" ]] || exit 0
    printf '%s\n' "${selection}"
}

atomic_install() {
    local source_file=$1 destination_file=$2 destination_dir temp_file

    destination_dir="$(dirname "${destination_file}")"
    mkdir -p "${destination_dir}"
    temp_file="$(mktemp "${destination_dir}/.$(basename "${destination_file}").XXXXXX")"
    cp "${source_file}" "${temp_file}"
    chmod 0644 "${temp_file}"
    mv -f "${temp_file}" "${destination_file}"
}

if (($# > 1)); then
    die "Usage: theme-select [theme-name]"
fi

THEME="${1:-}"
[[ -n "${THEME}" ]] || THEME="$(choose_theme)"
[[ "${THEME}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "Theme name contains unsupported characters."

readonly THEME
readonly TARGET_THEME="${THEMES_DIR}/${THEME}"
[[ -d "${TARGET_THEME}" ]] || die "Theme '${THEME}' does not exist."

for required_file in "${REQUIRED_FILES[@]}"; do
    [[ -f "${TARGET_THEME}/${required_file}" ]] ||
        die "Theme '${THEME}' is incomplete: missing '${required_file}'."
done

printf 'Applying theme: %s\n' "${THEME}"

atomic_install "${TARGET_THEME}/colors.conf" \
    "${CONFIG_DIR}/hypr/current_colors.conf"
atomic_install "${TARGET_THEME}/colors.lua" \
    "${CONFIG_DIR}/hypr/current_colors.lua"
atomic_install "${TARGET_THEME}/colors.css" \
    "${CONFIG_DIR}/waybar/colors.css"
atomic_install "${TARGET_THEME}/kitty-theme.conf" \
    "${CONFIG_DIR}/kitty/kitty-theme.conf"
atomic_install "${TARGET_THEME}/rofi-theme.rasi" \
    "${CONFIG_DIR}/rofi/rofi-theme.rasi"
atomic_install "${TARGET_THEME}/dunstrc" \
    "${CONFIG_DIR}/dunst/dunstrc"
atomic_install "${TARGET_THEME}/gtk-4.0/gtk.css" \
    "${CONFIG_DIR}/gtk-4.0/gtk.css"
atomic_install "${TARGET_THEME}/wallpaper.png" \
    "${CONFIG_DIR}/hypr/current_wallpaper.png"

hyprpaper_temp="$(mktemp "${CONFIG_DIR}/hypr/.hyprpaper.conf.XXXXXX")"
cat > "${hyprpaper_temp}" <<HYPRPAPER
preload = ${CONFIG_DIR}/hypr/current_wallpaper.png
wallpaper = , ${CONFIG_DIR}/hypr/current_wallpaper.png
splash = false
HYPRPAPER
chmod 0644 "${hyprpaper_temp}"
mv -f "${hyprpaper_temp}" "${CONFIG_DIR}/hypr/hyprpaper.conf"

if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null; then
    hyprctl reload >/dev/null 2>&1 || true
fi
if pgrep -x hyprpaper >/dev/null; then
    pkill -x hyprpaper
    hyprpaper >/dev/null 2>&1 &
fi
if pgrep -x waybar >/dev/null; then
    pkill -USR2 -x waybar || true
fi
if command -v dunstctl >/dev/null 2>&1 && pgrep -x dunst >/dev/null; then
    dunstctl reload >/dev/null 2>&1 || true
fi

if command -v notify-send >/dev/null 2>&1 &&
    [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    notify-send -i preferences-desktop-theme \
        "Theme Engine" "Applied '${THEME}' to the desktop." || true
fi

printf "Theme '%s' applied successfully.\n" "${THEME}"
