#!/usr/bin/env bash
# Validate the installed workstation from inside the target system.

set -Eeuo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}"
FAILURES=0

pass() {
    printf 'PASS  %s\n' "$1"
}

fail() {
    printf 'FAIL  %s\n' "$1" >&2
    FAILURES=$((FAILURES + 1))
}

check() {
    local description=$1
    shift
    if "$@" >/dev/null 2>&1; then
        pass "${description}"
    else
        fail "${description}"
    fi
}

PROFILE="${1:-}"
USER_RUNTIME_DIR="/run/user/$(id -u)"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" &&
    -S "${USER_RUNTIME_DIR}/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${USER_RUNTIME_DIR}/bus"
fi
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" &&
    -d "${USER_RUNTIME_DIR}/hypr" ]]; then
    while IFS= read -r socket_dir; do
        export HYPRLAND_INSTANCE_SIGNATURE="${socket_dir##*/}"
        break
    done < <(find "${USER_RUNTIME_DIR}/hypr" -mindepth 1 -maxdepth 1 -type d)
fi

if [[ -z "${PROFILE}" && -f "${CONFIG_DIR}/costa/install-profile" ]]; then
    PROFILE="$(<"${CONFIG_DIR}/costa/install-profile")"
fi
if [[ -z "${PROFILE}" ]] && systemd-detect-virt --vm --quiet; then
    PROFILE=vm
fi
PROFILE="${PROFILE:-bare-metal}"

for package in \
    base linux grub networkmanager firewalld pipewire wireplumber \
    hyprland quickshell kitty dunst sddm gnome-keyring cliphist jq \
    zram-generator; do
    check "package ${package}" pacman -Q "${package}"
done

case "${PROFILE}" in
    vm)
        check "VM guest agent package" pacman -Q qemu-guest-agent
        check "SPICE guest package" pacman -Q spice-vdagent
        ;;
    bare-metal)
        check "Bluetooth package" pacman -Q bluez
        check "firmware update package" pacman -Q fwupd
        check "SMART tools package" pacman -Q smartmontools
        check "NVMe tools package" pacman -Q nvme-cli
        ;;
    *) fail "known install profile (${PROFILE})" ;;
esac

for unit in NetworkManager.service firewalld.service sddm.service; do
    check "${unit} enabled" systemctl is-enabled "${unit}"
done
if [[ "${PROFILE}" == bare-metal ]]; then
    check "bluetooth.service enabled" systemctl is-enabled bluetooth.service
else
    check "qemu-guest-agent enabled" systemctl is-enabled qemu-guest-agent.service
fi
check "zram configuration" test -f /etc/systemd/zram-generator.conf

check "Costa Utils entry point" test -x "${HOME}/.local/bin/costa-utils"
check "qs-activity entry point" test -x "${HOME}/.local/bin/qs-activity"
check "Costa Utils desktop entry" \
    test -f "${DATA_DIR}/applications/org.fcosta.CostaUtils.desktop"
check "Costa Utils icon" \
    test -f "${DATA_DIR}/icons/hicolor/scalable/apps/org.fcosta.CostaUtils.svg"
check "Hyprland Lua config" test -f "${CONFIG_DIR}/hypr/hyprland.lua"
check "Quickshell shell entry" test -f "${CONFIG_DIR}/quickshell/costa/shell.qml"
check "transactional theme pointer" test -L "${CONFIG_DIR}/costa/current-theme"
check "Quickshell theme palette" test -e "${CONFIG_DIR}/quickshell/costa/colors.css"
check "GTK4 theme CSS" test -e "${CONFIG_DIR}/gtk-4.0/gtk.css"
check "GTK prefer-dark settings" \
    grep -Fq 'gtk-application-prefer-dark-theme=1' "${CONFIG_DIR}/gtk-4.0/settings.ini"
check "Quickshell profile state" grep -Fxq "${PROFILE}" "${CONFIG_DIR}/costa/install-profile"
check "Quickshell profile file" test -f "${CONFIG_DIR}/quickshell/costa/profile.json"

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v gsettings >/dev/null 2>&1; then
    check "GNOME color-scheme prefer-dark" \
        bash -c '[[ "$(gsettings get org.gnome.desktop.interface color-scheme)" == *"prefer-dark"* ]]'
fi

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    check "Hyprland session target active" \
        systemctl --user is-active hyprland-session.target
    for unit in quickshell.service dunst.service hyprpaper.service cliphist-text.service; do
        check "${unit} active" systemctl --user is-active "${unit}"
    done
fi

if python - "${CONFIG_DIR}/quickshell/costa" <<'PY'
import json
from pathlib import Path
import sys

qs_root = Path(sys.argv[1])
for name in ("profile.json", "profile-bare-metal.json", "profile-vm.json", "user.json"):
    json.loads((qs_root / name).read_text(encoding="utf-8"))
for required in ("shell.qml", "Bar.qml", "Colors.qml", "Profile.qml", "colors.css"):
    if not (qs_root / required).is_file():
        raise SystemExit(f"missing {required}")
palette = (qs_root / "colors.css").read_text(encoding="utf-8")
if "@define-color background" not in palette:
    raise SystemExit("colors.css missing background")
PY
then
    pass "Quickshell installed assets"
else
    fail "Quickshell installed assets"
fi

if "${HOME}/.local/bin/costa-utils" --help >/dev/null 2>&1; then
    pass "Costa Utils --help"
else
    fail "Costa Utils --help"
fi

if command -v hyprctl >/dev/null 2>&1 &&
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    config_errors="$(hyprctl configerrors 2>&1 || true)"
    [[ -z "${config_errors}" ]] && pass "Hyprland configerrors empty" ||
        fail "Hyprland configerrors empty: ${config_errors}"
fi

if ((FAILURES > 0)); then
    printf '\n%d installed-system check(s) failed.\n' "${FAILURES}" >&2
    exit 1
fi
printf '\nInstalled %s workstation validation passed.\n' "${PROFILE}"
