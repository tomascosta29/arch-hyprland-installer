#!/usr/bin/env bash
# Configure keyboard layout and Waybar clock format for the desktop user.

set -Eeuo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly SETTINGS_FILE="${CONFIG_DIR}/costa/desktop.env"
readonly HYPR_INPUT_LUA="${CONFIG_DIR}/hypr/input.lua"
readonly WAYBAR_USER="${CONFIG_DIR}/waybar/user.jsonc"

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: desktop-settings [--keyboard LAYOUT] [--clock 12h|24h] [--show]

Configure Hyprland keyboard layout and Waybar clock formatting.
Without flags, prompts interactively.
EOF
}

atomic_write() {
    local destination=$1
    local contents=$2
    local destination_dir temp_file

    destination_dir="$(dirname "${destination}")"
    mkdir -p "${destination_dir}"
    temp_file="$(mktemp "${destination_dir}/.$(basename "${destination}").XXXXXX")"
    printf '%s\n' "${contents}" > "${temp_file}"
    chmod 0644 "${temp_file}"
    mv -f "${temp_file}" "${destination}"
}

write_settings() {
    local layout=$1
    local clock_format=$2
    local waybar_format hypr_lua waybar_json

    if [[ "${clock_format}" == "12h" ]]; then
        waybar_format="{:%a %d %b %I:%M %p}"
    else
        waybar_format="{:%a %d %b %H:%M}"
    fi

    atomic_write "${SETTINGS_FILE}" "$(cat <<EOF
KB_LAYOUT=${layout}
CLOCK_FORMAT=${clock_format}
EOF
)"

    hypr_lua="$(cat <<EOF
-- Generated by desktop-settings; do not edit by hand.
hl.config({
    input = {
        kb_layout = "${layout}",
        kb_variant = "",
        kb_model = "",
        kb_options = "",
        follow_mouse = 1,
        sensitivity = 0,
        touchpad = {
            natural_scroll = false,
        },
    },
})
EOF
)"
    atomic_write "${HYPR_INPUT_LUA}" "${hypr_lua}"

    waybar_json="$(cat <<EOF
{
    "clock": {
        "interval": 60,
        "format": "${waybar_format}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
}
EOF
)"
    atomic_write "${WAYBAR_USER}" "${waybar_json}"

    if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null; then
        hyprctl reload >/dev/null 2>&1 || true
    fi
    if command -v systemctl >/dev/null 2>&1 &&
        systemctl --user is-active --quiet hyprland-session.target; then
        systemctl --user try-reload-or-restart waybar.service \
            >/dev/null 2>&1 || true
    fi

    printf "Desktop settings applied (keyboard=%s, clock=%s).\n" \
        "${layout}" "${clock_format}"
}

show_settings() {
    if [[ -f "${SETTINGS_FILE}" ]]; then
        cat "${SETTINGS_FILE}"
    else
        printf 'KB_LAYOUT=pt\nCLOCK_FORMAT=24h\n'
    fi
}

KEYBOARD=""
CLOCK=""
SHOW=false

while (($# > 0)); do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --show)
            SHOW=true
            shift
            ;;
        --keyboard)
            (($# >= 2)) || die "--keyboard requires a layout value."
            KEYBOARD=$2
            shift 2
            ;;
        --clock)
            (($# >= 2)) || die "--clock requires 12h or 24h."
            CLOCK=$2
            shift 2
            ;;
        *)
            die "Unknown argument: $1"
            ;;
    esac
done

if [[ "${SHOW}" == true ]]; then
    show_settings
    exit 0
fi

if [[ -z "${KEYBOARD}" && -z "${CLOCK}" ]]; then
    current_layout="pt"
    current_clock="24h"
    if [[ -f "${SETTINGS_FILE}" ]]; then
        # shellcheck disable=SC1090
        source "${SETTINGS_FILE}"
        current_layout="${KB_LAYOUT:-pt}"
        current_clock="${CLOCK_FORMAT:-24h}"
    fi
    read -r -p "Keyboard layout [${current_layout}]: " KEYBOARD
    KEYBOARD="${KEYBOARD:-${current_layout}}"
    read -r -p "Clock format (12h/24h) [${current_clock}]: " CLOCK
    CLOCK="${CLOCK:-${current_clock}}"
fi

if [[ -z "${KEYBOARD}" || -z "${CLOCK}" ]]; then
    current_layout="pt"
    current_clock="24h"
    if [[ -f "${SETTINGS_FILE}" ]]; then
        # shellcheck disable=SC1090
        source "${SETTINGS_FILE}"
        current_layout="${KB_LAYOUT:-pt}"
        current_clock="${CLOCK_FORMAT:-24h}"
    fi
    KEYBOARD="${KEYBOARD:-${current_layout}}"
    CLOCK="${CLOCK:-${current_clock}}"
fi

[[ "${KEYBOARD}" =~ ^[a-zA-Z0-9,_-]+$ ]] ||
    die "Keyboard layout contains unsupported characters."
[[ "${CLOCK}" == "12h" || "${CLOCK}" == "24h" ]] ||
    die "Clock format must be '12h' or '24h'."

write_settings "${KEYBOARD}" "${CLOCK}"
