[global]
    font = "JetBrainsMono Nerd Font 10"
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "300x5-30+50"
    transparency = 10
    idle_threshold = 120
    monitor = 0

    frame_width = 2
    corner_radius = 8
    frame_color = "#7aa2f7"
    separator_color = frame

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#24283b"
    foreground = "#c0caf5"
    timeout = 8

[urgency_critical]
    background = "#f7768e"
    foreground = "#1a1b26"
    frame_color = "#ff9e64"
    timeout = 0
