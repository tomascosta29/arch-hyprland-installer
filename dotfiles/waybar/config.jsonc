// Waybar config file
{
    "include": [
        "~/.config/waybar/modules",
        "~/.config/waybar/user.jsonc"
    ],
    "layer": "top",
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    "height": 43,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 11,
    "margin-right": 11,
    "margin-bottom": 0,
    "fixed-center": true,
    "ipc": true,

    "modules-left": [
        "custom/menu",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock",
        "hyprland/window"
    ],

    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "bluetooth",
        "network",
        "custom/updates",
        "custom/clipboard",
        "custom/screenshot",
        "group/usage",
        "tray",
        "custom/power"
    ],

    "group/usage": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/system",
            "cpu",
            "custom/sep",
            "memory",
            "custom/sep",
            "custom/gpu",
            "custom/sep",
            "custom/vram",
            "custom/sep",
            "disk",
            "custom/sep",
            "temperature"
        ]
    }
}
