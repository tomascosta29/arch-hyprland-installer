{
    // Workspaces: numbered pills; occupied and active states stay distinct.
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": false,
        "sort-by": "number",
        "persistent-workspaces": {
            "*": 10
        }
    },
    // Window Title
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "": "󰇄  Desktop"
        }
    },
    // Tray
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    // Clock defaults; ~/.config/waybar/user.jsonc overrides the format.
    "clock": {
        "interval": 60,
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    // System Icon (Drawer Trigger)
    "custom/system": {
        "format": " 󱓞 ",
        "tooltip": false,
        "on-click": "kitty --class system-monitor -e htop"
    },
    // CPU
    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "states": {
            "warn": 70,
            "crit": 90
        },
        "on-click": "kitty --class system-monitor -e htop"
    },
    // GPU
    "custom/gpu": {
        "exec": "~/.config/scripts/amd-gpu-stat usage",
        "interval": 5,
        "format": "󰢮 {}%",
        "tooltip": false,
        "on-click": "kitty --class system-monitor -e htop"
    },
    // VRAM
    "custom/vram": {
        "exec": "~/.config/scripts/amd-gpu-stat vram",
        "interval": 10,
        "format": "󰘚 {}G",
        "tooltip": false,
        "on-click": "kitty --class system-monitor -e htop"
    },
    // Separator
    "custom/sep": {
        "format": "|",
        "tooltip": false
    },
    // Memory
    "memory": {
        "interval": 10,
        "format": "󰘚 {used:0.1f}G",
        "states": {
            "warn": 75,
            "crit": 90
        },
        "on-click": "kitty --class system-monitor -e htop"
    },
    // Disk
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 {free}",
        "states": {
            "warn": 80,
            "crit": 90
        },
        "on-click": "nautilus /"
    },
    // Temperature
    "temperature": {
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 85,
        "on-click": "kitty --class system-monitor -e watch -n 2 sensors"
    },
    // Network
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Connected",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid}\nIP: {ipaddr}\nGW: {gwaddr}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nGW: {gwaddr}",
        "on-click": "~/.local/bin/costa-utils --network-menu"
    },
    // Pulseaudio
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.local/bin/costa-utils --volume-menu",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "smooth-scrolling-threshold": 1
    },
    // Updates (Arch/pacman)
    "custom/updates": {
        "exec": "~/.config/scripts/check_updates",
        "interval": 1800,
        "format": "󰚰 {}",
        "return-type": "json",
        "on-click": "kitty --class system-updates -e sudo pacman -Syu"
    },
    // Idle Inhibitor
    "idle_inhibitor": {
        "format": "{icon} ",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        }
    },
    // Bluetooth
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "",
        "on-click": "~/.local/bin/costa-utils --bluetooth-menu",
        "tooltip-format-connected": "{device_enumerate}"
    },
    // Custom Menu
    "custom/menu": {
        "format": "󰣇",
        "on-click": "~/.local/bin/costa-utils --app-menu",
        "tooltip": false
    },
    // Custom Power
    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.local/bin/costa-utils --power-menu",
        "tooltip": false
    },
    // Clipboard History
    "custom/clipboard": {
        "format": "󰅌",
        "on-click": "~/.local/bin/costa-utils --clipper",
        "tooltip": false
    },
    // Screenshot
    "custom/screenshot": {
        "format": "󰄀",
        "on-click": "~/.local/bin/costa-utils --blinker",
        "tooltip": false
    }
}
