# ==============================================================================
# Dunst Notification Daemon Configuration
# ==============================================================================

[global]
    font = "JetBrainsMono Nerd Font 10"
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    width = 300
    height = (0, 300)
    notification_limit = 5
    origin = top-right
    offset = (30, 50)
    transparency = 10
    idle_threshold = 120
    monitor = 0

    # Frame & Progress
    frame_width = 2
    corner_radius = 8
    frame_color = "#89b4fa"
    separator_color = frame

[urgency_low]
    background = "#24273a"
    foreground = "#cad3f5"
    timeout = 5

[urgency_normal]
    background = "#363a4f"
    foreground = "#cad3f5"
    timeout = 8

[urgency_critical]
    background = "#ed8796"
    foreground = "#24273a"
    frame_color = "#f5a97f"
    timeout = 0
