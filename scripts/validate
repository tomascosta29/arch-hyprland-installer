#!/usr/bin/env bash
# Run all repository checks that are available on the current machine.

set -Eeuo pipefail

readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPOSITORY_ROOT}"

bash_files=(
    install.sh
    scripts/build-release.sh
    scripts/create-vm
    scripts/deploy-user
    scripts/vm-smoke
    scripts/lib/costa-utils.sh
    costa-utils/scripts/install-user.sh
    dotfiles/scripts/*
)
bash -n "${bash_files[@]}"

command -v ruff >/dev/null 2>&1 || {
    printf 'Error: ruff is required for Python validation.\n' >&2
    exit 1
}
ruff check tests

PYTHONDONTWRITEBYTECODE=1 python -m unittest discover -s tests -v

if command -v cargo >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source "${HOME}/.cargo/env" 2>/dev/null || true
    cargo test --manifest-path costa-utils/Cargo.toml --workspace
else
    printf 'Warning: cargo is unavailable; skipping costa-utils Rust tests.\n' >&2
fi

if command -v luac >/dev/null 2>&1; then
    while IFS= read -r -d '' lua_file; do
        luac -p "${lua_file}"
    done < <(find dotfiles/hypr dotfiles/themes -type f -name '*.lua' -print0)
else
    printf 'Warning: luac is unavailable; skipping Lua syntax validation.\n' >&2
fi

desktop_file="costa-utils/assets/applications/org.fcosta.CostaUtils.desktop"
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "${desktop_file}"
else
    printf 'Warning: desktop-file-validate is unavailable; skipping desktop validation.\n' >&2
fi

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck --severity=error "${bash_files[@]}"
else
    printf 'Warning: shellcheck is unavailable; skipping semantic Bash lint.\n' >&2
fi

git diff --check
printf 'All available validation checks passed.\n'
