#!/usr/bin/env bash
# Disposable libvirt smoke test that never mutates the validated archlinux VM.
#
# Default mode creates a temporary qcow2 overlay volume backed by archlinux.qcow2
# through the libvirt storage pool, boots it, runs guest-agent checks, then
# destroys the disposable domain and volume.
#
# Optional --full-install mode provisions a fresh disk from an Arch ISO. That
# path requires COSTA_E2E_CONFIRM_DESTROY=1 and does not touch archlinux.

set -Eeuo pipefail

readonly CONNECT="${LIBVIRT_DEFAULT_URI:-qemu:///system}"
readonly BASE_DOMAIN="${COSTA_E2E_BASE_DOMAIN:-archlinux}"
readonly BASE_DISK_NAME="${COSTA_E2E_BASE_DISK_NAME:-archlinux.qcow2}"
readonly STORAGE_POOL="${COSTA_E2E_STORAGE_POOL:-default}"
readonly ARCH_ISO="${ARCH_ISO:-${COSTA_E2E_ARCH_ISO:-/home/fcosta/Downloads/archlinux-x86_64.iso}}"
NVRAM_TEMPLATE="${COSTA_E2E_NVRAM_TEMPLATE:-/var/lib/libvirt/qemu/nvram/archlinux_VARS.qcow2}"
readonly RUN_ID="$$"
readonly DOMAIN="costa-e2e-${RUN_ID}"
readonly OVERLAY_VOL="${DOMAIN}.qcow2"
readonly HELPER_PY="${TMPDIR:-/tmp}/costa-e2e-guest-exec-${RUN_ID}.py"

MODE="smoke"
KEEP=false
OVERLAY_DISK=""

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: e2e-libvirt [--smoke|--full-install] [--keep]

  --smoke          Boot a disposable overlay of the validated archlinux disk
                   and verify services, packages, Hyprland, and costa-utils
                   launchers through the QEMU guest agent.
  --full-install   Create an empty disposable disk and boot the Arch ISO.
                   Requires ARCH_ISO and COSTA_E2E_CONFIRM_DESTROY=1.
  --keep           Leave the disposable domain and disk for inspection.
EOF
}

cleanup() {
    local exit_status=$?

    rm -f "${HELPER_PY}"

    if [[ "${KEEP}" == true ]]; then
        printf 'Keeping disposable domain %s and volume %s\n' \
            "${DOMAIN}" "${OVERLAY_VOL}" >&2
        exit "${exit_status}"
    fi

    if virsh --connect "${CONNECT}" dominfo "${DOMAIN}" >/dev/null 2>&1; then
        virsh --connect "${CONNECT}" destroy "${DOMAIN}" >/dev/null 2>&1 || true
        virsh --connect "${CONNECT}" undefine "${DOMAIN}" --nvram >/dev/null 2>&1 ||
            virsh --connect "${CONNECT}" undefine "${DOMAIN}" >/dev/null 2>&1 || true
    fi
    if virsh --connect "${CONNECT}" vol-info --pool "${STORAGE_POOL}" "${OVERLAY_VOL}" \
        >/dev/null 2>&1; then
        virsh --connect "${CONNECT}" vol-delete --pool "${STORAGE_POOL}" "${OVERLAY_VOL}" \
            >/dev/null 2>&1 || true
    fi

    if ((exit_status != 0)); then
        printf 'Disposable E2E failed (exit %d).\n' "${exit_status}" >&2
    fi
}

write_helper() {
    cat > "${HELPER_PY}" <<'PY'
import base64
import json
import subprocess
import sys
import time

connect, domain, command = sys.argv[1:4]
payload = json.dumps(
    {
        "execute": "guest-exec",
        "arguments": {
            "path": "/bin/bash",
            "arg": ["-lc", command],
            "capture-output": True,
        },
    }
)
raw = subprocess.check_output(
    ["virsh", "--connect", connect, "qemu-agent-command", domain, payload]
)
pid = json.loads(raw)["return"]["pid"]
for _ in range(120):
    time.sleep(0.5)
    status_payload = json.dumps(
        {"execute": "guest-exec-status", "arguments": {"pid": pid}}
    )
    status_raw = subprocess.check_output(
        [
            "virsh",
            "--connect",
            connect,
            "qemu-agent-command",
            domain,
            status_payload,
        ]
    )
    ret = json.loads(status_raw)["return"]
    if ret.get("exited"):
        out = base64.b64decode(ret.get("out-data") or b"").decode("utf-8", "ignore")
        err = base64.b64decode(ret.get("err-data") or b"").decode("utf-8", "ignore")
        sys.stdout.write(out)
        sys.stderr.write(err)
        raise SystemExit(ret.get("exitcode", 1))
raise SystemExit("guest-exec timed out")
PY
}

guest_exec() {
    python "${HELPER_PY}" "${CONNECT}" "${DOMAIN}" "$1"
}

wait_for_agent() {
    local attempt
    for attempt in {1..90}; do
        if virsh --connect "${CONNECT}" qemu-agent-command "${DOMAIN}" \
            '{"execute":"guest-ping"}' >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    die "QEMU guest agent did not become ready for ${DOMAIN}."
}

require_tools() {
    local tool
    for tool in virsh python; do
        command -v "${tool}" >/dev/null 2>&1 || die "Missing required tool: ${tool}"
    done
}

assert_base_safe() {
    local state

    virsh --connect "${CONNECT}" dominfo "${BASE_DOMAIN}" >/dev/null 2>&1 ||
        die "Base domain '${BASE_DOMAIN}' was not found."
    virsh --connect "${CONNECT}" vol-info --pool "${STORAGE_POOL}" "${BASE_DISK_NAME}" \
        >/dev/null 2>&1 ||
        die "Base volume '${BASE_DISK_NAME}' was not found in pool '${STORAGE_POOL}'."
    [[ "${DOMAIN}" != "${BASE_DOMAIN}" ]] || die "Refusing to reuse the base domain name."

    if [[ ! -f "${NVRAM_TEMPLATE}" ]]; then
        # The host user may lack filesystem permission; resolve via domain XML instead.
        NVRAM_TEMPLATE="$(
            virsh --connect "${CONNECT}" dumpxml "${BASE_DOMAIN}" |
                sed -n 's:.*<nvram[^>]*>\([^<]*\)</nvram>.*:\1:p' | head -n1
        )"
        [[ -n "${NVRAM_TEMPLATE}" ]] ||
            die "Could not resolve an NVRAM template from '${BASE_DOMAIN}'."
    fi

    state="$(virsh --connect "${CONNECT}" domstate "${BASE_DOMAIN}" 2>/dev/null || true)"
    [[ "${state}" != "running" ]] ||
        die "Shut down '${BASE_DOMAIN}' before creating a disposable overlay (current state: running)."
}

create_overlay_domain() {
    local xml
    assert_base_safe

    virsh --connect "${CONNECT}" vol-create-as \
        "${STORAGE_POOL}" "${OVERLAY_VOL}" 40G \
        --format qcow2 \
        --backing-vol "${BASE_DISK_NAME}" \
        --backing-vol-format qcow2 >/dev/null
    OVERLAY_DISK="$(
        virsh --connect "${CONNECT}" vol-path --pool "${STORAGE_POOL}" "${OVERLAY_VOL}"
    )"

    xml="$(cat <<EOF
<domain type='kvm'>
  <name>${DOMAIN}</name>
  <memory unit='MiB'>4096</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-10.1'>hvm</type>
    <loader readonly='yes' secure='no' type='pflash' format='qcow2'>/usr/share/edk2/ovmf/OVMF_CODE_4M.qcow2</loader>
    <nvram template='${NVRAM_TEMPLATE}' templateFormat='qcow2' format='qcow2'/>
    <boot dev='hd'/>
  </os>
  <features><acpi/><apic/><vmport state='off'/></features>
  <cpu mode='host-passthrough' check='none' migratable='on'/>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='${OVERLAY_DISK}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <graphics type='spice' autoport='yes'/>
    <video><model type='virtio' heads='1' primary='yes'/></video>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <controller type='virtio-serial' index='0'/>
    <memballoon model='virtio'/>
  </devices>
</domain>
EOF
)"
    virsh --connect "${CONNECT}" define /dev/stdin <<<"${xml}" >/dev/null
    virsh --connect "${CONNECT}" start "${DOMAIN}" >/dev/null
}

run_smoke_checks() {
    local output

    wait_for_agent

    output="$(guest_exec "$(cat <<'EOS'
set -euo pipefail
test -f /etc/fstab
grep -Eq '[[:space:]]/[[:space:]]' /etc/fstab
grep -Eq '[[:space:]]/boot[[:space:]]' /etc/fstab
systemctl is-enabled NetworkManager.service >/dev/null
systemctl is-enabled bluetooth.service >/dev/null
systemctl is-enabled sddm.service >/dev/null
command -v hyprlock >/dev/null
command -v hyprland >/dev/null || command -v Hyprland >/dev/null
id -u fcosta >/dev/null
test -x /home/fcosta/.local/bin/costa-utils
command -v firefox >/dev/null
test -f /usr/share/sddm/themes/costa/Main.qml
test -f /etc/sddm.conf.d/costa.conf
SOCK=$(find /run/user/1000/hypr -name .socket.sock 2>/dev/null | head -n1 || true)
if [[ -n "${SOCK}" ]]; then
  SIG=$(basename "$(dirname "${SOCK}")")
  ERR=$(su - fcosta -c "XDG_RUNTIME_DIR=/run/user/1000 HYPRLAND_INSTANCE_SIGNATURE=${SIG} hyprctl configerrors" || true)
  test -z "$(printf '%s' "${ERR}" | tr -d '[:space:]')"
fi
for flag in --help --app-menu --clipper --power-menu --network-menu --bluetooth-menu --volume-menu --control-center --blinker; do
  su - fcosta -c "timeout 2 ~/.local/bin/costa-utils ${flag}" >/dev/null 2>&1 || true
done
printf 'e2e-smoke-ok\n'
EOS
)")"

    printf '%s\n' "${output}" | grep -qx 'e2e-smoke-ok' ||
        die "Smoke checks did not report success."
    printf 'Disposable smoke E2E passed for domain %s.\n' "${DOMAIN}"
}

run_full_install() {
    [[ "${COSTA_E2E_CONFIRM_DESTROY:-}" == "1" ]] ||
        die "Refusing full install without COSTA_E2E_CONFIRM_DESTROY=1."
    [[ -f "${ARCH_ISO}" ]] || die "Arch ISO not found at '${ARCH_ISO}'."
    command -v virt-install >/dev/null 2>&1 || die "virt-install is required for --full-install."

    virsh --connect "${CONNECT}" vol-create-as \
        "${STORAGE_POOL}" "${OVERLAY_VOL}" 40G --format qcow2 >/dev/null
    OVERLAY_DISK="$(
        virsh --connect "${CONNECT}" vol-path --pool "${STORAGE_POOL}" "${OVERLAY_VOL}"
    )"

    virt-install \
        --connect "${CONNECT}" \
        --name "${DOMAIN}" \
        --memory 4096 \
        --vcpus 2 \
        --cpu host-passthrough \
        --disk "path=${OVERLAY_DISK},format=qcow2,bus=virtio" \
        --cdrom "${ARCH_ISO}" \
        --osinfo archlinux \
        --graphics spice \
        --video virtio \
        --channel unix,target.type=virtio,name=org.qemu.guest_agent.0 \
        --network network=default,model=virtio \
        --boot uefi \
        --noautoconsole

    cat <<EOF
Disposable install domain '${DOMAIN}' is booting the Arch ISO on ${OVERLAY_DISK}.
Drive install.sh noninteractively inside that guest with:

  COSTA_INSTALL_NONINTERACTIVE=1
  COSTA_INSTALL_DISK=/dev/vda
  COSTA_INSTALL_CONFIRM_DISK=/dev/vda
  COSTA_INSTALL_PASSWORD=...

This does not modify the validated '${BASE_DOMAIN}' domain.
EOF
    KEEP=true
}

while (($# > 0)); do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --smoke)
            MODE=smoke
            shift
            ;;
        --full-install)
            MODE=full-install
            shift
            ;;
        --keep)
            KEEP=true
            shift
            ;;
        *)
            die "Unknown argument: $1"
            ;;
    esac
done

require_tools
write_helper
trap cleanup EXIT

case "${MODE}" in
    smoke)
        create_overlay_domain
        run_smoke_checks
        ;;
    full-install)
        run_full_install
        ;;
    *)
        die "Unknown mode: ${MODE}"
        ;;
esac
