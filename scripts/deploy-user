#!/usr/bin/env bash
# Deploy the repository's user configuration into the current account.

set -Eeuo pipefail

readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly BIN_DIR="${HOME}/.local/bin"
readonly STATE_DIR="${CONFIG_DIR}/costa"
readonly MANIFEST_FILE="${STATE_DIR}/managed-files"
readonly THEME="${1:-fcosta}"
readonly RELOAD_DESKTOP="${COSTA_DEPLOY_RELOAD:-1}"
readonly CONFIG_COMPONENTS=(dunst hypr kitty quickshell rofi scripts systemd themes)
ACTIVE_MONITOR_PROFILE=""
readonly RETIRED_CONFIG_FILES=(
    hypr/current_colors.conf
    hypr/hyprland.conf
    hypr/input.conf
    hypr/monitors.conf
    hypr/monitors/monitors-dual-host.conf
    hypr/monitors/monitors-single.conf
    themes/catppuccin-macchiato/colors.conf
    themes/fcosta/colors.conf
    themes/tokyo-night/colors.conf
    waybar/colors.css
    waybar/config.jsonc
    waybar/modules
    waybar/profile.jsonc
    waybar/profile-bare-metal.jsonc
    waybar/profile-vm.jsonc
    waybar/style.css
    waybar/user.jsonc
)

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

append_tree_manifest() {
    local kind=$1 source_root=$2 destination_prefix=$3 source relative

    while IFS= read -r -d '' source; do
        relative="${source#"${source_root}/"}"
        [[ "${relative}" != */__pycache__/* && "${relative}" != *.pyc ]] || continue
        printf '%s\t%s/%s\n' "${kind}" "${destination_prefix}" "${relative}" \
            >> "${NEW_MANIFEST}"
    done < <(find "${source_root}" \( -type f -o -type l \) -print0)
}

remove_previous_manifest() {
    local kind relative root target

    [[ -f "${MANIFEST_FILE}" ]] || return 0
    while IFS=$'\t' read -r kind relative; do
        [[ -n "${relative}" && "${relative}" != /* ]] || continue
        [[ "/${relative}/" != *"/../"* ]] || continue
        # Files that remain managed are replaced in place below. Deleting them
        # first creates a visible gap for live file watchers such as Hyprland
        # and Quickshell, which then report transient missing-config errors.
        if grep -Fqx "${kind}"$'\t'"${relative}" "${NEW_MANIFEST}"; then
            continue
        fi
        case "${kind}" in
            CONFIG) root="${CONFIG_DIR}" ;;
            DATA) root="${DATA_DIR}" ;;
            BIN) root="${BIN_DIR}" ;;
            *) continue ;;
        esac
        target="${root}/${relative}"
        [[ -f "${target}" || -L "${target}" ]] && rm -f -- "${target}"
    done < "${MANIFEST_FILE}"
}

((EUID != 0)) || die "Run this command as the target desktop user, not root."
[[ "${THEME}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "Theme name contains unsupported characters."
[[ "${RELOAD_DESKTOP}" == 0 || "${RELOAD_DESKTOP}" == 1 ]] ||
    die "COSTA_DEPLOY_RELOAD must be 0 or 1."
[[ -d "${REPOSITORY_ROOT}/dotfiles/themes/${THEME}" ]] ||
    die "Theme '${THEME}' does not exist."

# `hypr/monitors.lua` is managed infrastructure but its selected profile is
# mutable user state. Preserve a valid selection before replacing managed files.
if [[ -f "${CONFIG_DIR}/hypr/monitors.lua" ]]; then
    ACTIVE_MONITOR_PROFILE="$(
        sed -n \
            's/.*require("monitors\.monitors-\(single\|dual-host\)").*/\1/p' \
            "${CONFIG_DIR}/hypr/monitors.lua" |
            head -n 1
    )"
fi

# Stop the supervised process before replacing its executable, then shut down
# any legacy launcher-owned singleton that may still hold the D-Bus name.
if [[ "${RELOAD_DESKTOP}" == 1 ]] &&
    systemctl --user cat costa-utils.service >/dev/null 2>&1; then
    systemctl --user stop costa-utils.service
fi
if [[ "${RELOAD_DESKTOP}" == 1 && -x "${BIN_DIR}/costa-utils" ]]; then
    "${BIN_DIR}/costa-utils" --shutdown >/dev/null 2>&1 || true
fi

mkdir -p "${STATE_DIR}"
NEW_MANIFEST="$(mktemp "${STATE_DIR}/.managed-files.XXXXXX")"
trap 'rm -f "${NEW_MANIFEST}"' EXIT
for component in "${CONFIG_COMPONENTS[@]}"; do
    append_tree_manifest CONFIG \
        "${REPOSITORY_ROOT}/dotfiles/${component}" "${component}"
done
printf 'CONFIG\tmimeapps.list\n' >> "${NEW_MANIFEST}"
# costa-utils binary + desktop/icons are recorded by install_costa_utils.
printf '%s\n' \
    'BIN	qs-activity' >> "${NEW_MANIFEST}"

# Remove only paths recorded by an earlier deployment. Files created by the
# user outside that ownership manifest are never considered stale.
remove_previous_manifest

for component in "${CONFIG_COMPONENTS[@]}"; do
    source_dir="${REPOSITORY_ROOT}/dotfiles/${component}"
    [[ -d "${source_dir}" ]] || die "Missing dotfile component '${component}'."
    mkdir -p "${CONFIG_DIR}/${component}"
    cp -a "${source_dir}/." "${CONFIG_DIR}/${component}/"
done

if [[ -n "${ACTIVE_MONITOR_PROFILE}" ]]; then
    monitor_state="$(mktemp "${CONFIG_DIR}/hypr/.monitors.lua.XXXXXX")"
    printf '%s\n%s\n' \
        "-- Active Monitor Profile: ${ACTIVE_MONITOR_PROFILE}" \
        "require(\"monitors.monitors-${ACTIVE_MONITOR_PROFILE}\")" \
        > "${monitor_state}"
    chmod 0644 "${monitor_state}"
    mv -f "${monitor_state}" "${CONFIG_DIR}/hypr/monitors.lua"
fi

for retired_file in "${RETIRED_CONFIG_FILES[@]}"; do
    rm -f "${CONFIG_DIR}/${retired_file}"
done

mkdir -p "${BIN_DIR}"
# shellcheck source=lib/costa-utils.sh
source "${REPOSITORY_ROOT}/scripts/lib/costa-utils.sh"
install_costa_utils \
    "${REPOSITORY_ROOT}" \
    "${BIN_DIR}" \
    "${DATA_DIR}" \
    "${NEW_MANIFEST}" ||
    die "Failed to install Rust costa-utils."

ln -sfn "${CONFIG_DIR}/quickshell/costa/scripts/qs-activity" "${BIN_DIR}/qs-activity"
cp -a "${REPOSITORY_ROOT}/dotfiles/mimeapps.list" "${CONFIG_DIR}/mimeapps.list"

find "${CONFIG_DIR}/scripts" -type f -exec chmod 0755 {} +
find "${CONFIG_DIR}/quickshell/costa/scripts" -type f -exec chmod 0755 {} +
chmod 0755 "${BIN_DIR}/costa-utils" "${BIN_DIR}/qs-activity"
chmod 0644 "${NEW_MANIFEST}"
mv -f "${NEW_MANIFEST}" "${MANIFEST_FILE}"
trap - EXIT

if [[ "${RELOAD_DESKTOP}" == 1 ]] && pgrep -x Hyprland >/dev/null; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE
fi
if [[ "${RELOAD_DESKTOP}" == 1 ]]; then
    systemctl --user daemon-reload
    systemctl --user start costa-utils.service quickshell.service
fi

if [[ -f "${STATE_DIR}/install-profile" ]]; then
    INSTALL_PROFILE="$(<"${STATE_DIR}/install-profile")"
elif command -v systemd-detect-virt >/dev/null 2>&1 &&
    systemd-detect-virt --vm --quiet; then
    INSTALL_PROFILE=vm
else
    INSTALL_PROFILE=bare-metal
fi
COSTA_QUICKSHELL_RELOAD="${RELOAD_DESKTOP}" \
    "${CONFIG_DIR}/scripts/quickshell-profile" "${INSTALL_PROFILE}"

# Migrate a currently running pre-systemd session without waiting for logout.
if [[ "${RELOAD_DESKTOP}" == 1 ]] && pgrep -x Hyprland >/dev/null; then
    if systemctl --user cat hyprland-session.target >/dev/null 2>&1 &&
        ! systemctl --user is-active --quiet hyprland-session.target; then
        for legacy_process in \
            dunst hypridle hyprpaper hyprsunset spice-vdagent waybar quickshell qs; do
            pkill -x "${legacy_process}" >/dev/null 2>&1 || true
        done
        pkill -f -- \
            'wl-paste --type (text|image) --watch (/.*/)?cliphist store' \
            >/dev/null 2>&1 || true
        systemctl --user start hyprland-session.target
    fi
fi

COSTA_THEME_RELOAD="${RELOAD_DESKTOP}" \
    "${CONFIG_DIR}/scripts/theme-select" "${THEME}"
if [[ "${RELOAD_DESKTOP}" == 1 ]]; then
    # Theme application intentionally shuts down GTK clients so they reload
    # providers; restore the supervised resident only after that final stop.
    systemctl --user start costa-utils.service quickshell.service
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "${DATA_DIR}/applications"
fi

printf "User configuration deployed with theme '%s'.\n" "${THEME}"
